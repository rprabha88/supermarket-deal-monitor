# ── Required ────────────────────────────────────────────────────────────

# SearchAPI.io — get your key at https://www.searchapi.io
SEARCHAPI_API_KEY=aptLYUbqV4sfV4HHYoFsjD4V

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=dummy
TWILIO_AUTH_TOKEN=dummy

# Your Twilio WhatsApp sender number
# Sandbox default (for testing): whatsapp:+14155238886
# Production: your approved Twilio WhatsApp number e.g. whatsapp:+447700900000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Redis — local or managed (Upstash, Redis Cloud, Railway)
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=supermarket

# ── Optional ─────────────────────────────────────────────────────────────

# Phone number to receive scheduled daily alerts (no + prefix, e.g. 447442801959)
# Required for the daily 08:00 UTC scheduled job
DEFAULT_PHONE_NUMBER=447442801959

PORT=8000
LOGLEVEL=INFO
